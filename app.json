{
  "expo": {
    "name": "Ghost",
    "slug": "ghost-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080C0F"
    },
    "scheme": "ghost",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ghost.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ghost needs microphone access for voice messages",
        "NSPhotoLibraryUsageDescription": "Ghost needs photo library access to send images",
        "NSCameraUsageDescription": "Ghost needs camera access to capture images"
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#080C0F"
      },
      "package": "com.ghost.mobile",
      "permissions": [
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-av",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#00FF88",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ghost needs access to your photos to send images"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
